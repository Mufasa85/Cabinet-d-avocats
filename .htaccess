RewriteEngine On

# Handle /resources/ via PHP router (pass to index.php)

RewriteRule ^resources/(.\*)$ public/index.php?\_url=/resources/$1 [QSA,L]

# Redirect all other requests to public/index.php (preserve query string)

RewriteCond %{REQUEST_URI} !public/
RewriteRule ^(.\*)$ public/$1 [L,QSA]
