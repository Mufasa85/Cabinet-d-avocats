RewriteEngine On

# Redirect /resources/\* to index.php router (for PHP built-in server compatibility)

# This allows images from /resources/ to be accessed via <img src="/resources/...">

RewriteRule ^resources/(.\*)$ index.php?\_url=/resources/$1 [QSA,L]

# Allow direct access to assets folder

RewriteRule ^assets/ - [L]

# Allow direct access to css folder

RewriteRule ^css/ - [L]

# Allow direct access to js folder

RewriteRule ^js/ - [L]

# dynamically setup base URI

RewriteCond %{REQUEST_URI}::$1 ^(/.+)/(.*)::\2$
RewriteRule ^(.\*) - [E=BASE_URI:%1]

# redirect every request to index.php

# and give the relative URL in "\_url" GET param

# Si les 2 conditions ci-dessous ne sont pas respectées

# alors la règle "RewriteRule" ne s'applique pas

#1 Si le fichier demandé n'est pas un dossier existant
#2 ET Si le fichier demandé n'est pas un fichier existant
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
#3 Alors on applique la règle

RewriteRule ^(.\*)$ index.php?\_url=/$1 [QSA,L]

#4 Sinon on continue en affichant la page demandée

# Plus d'infos sur : https://httpd.apache.org/docs/2.4/fr/
